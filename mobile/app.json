{
  "expo": {
    "name": "Firdam",
    "slug": "firdam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.firdam.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Firdam uses your location to show prayer times, the Qibla and halal places near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F4EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.firdam.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F4EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "scheme": "firdam",
    "backgroundColor": "#F8F4EE",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f82ff99-c2a3-46cf-b494-191650d1efde"
      }
    },
    "owner": "firdam-app",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2f82ff99-c2a3-46cf-b494-191650d1efde"
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
